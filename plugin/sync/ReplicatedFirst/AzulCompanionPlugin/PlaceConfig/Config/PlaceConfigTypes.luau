-- Generated by Azul. Changes to this module are overwritten.

--- Pushed by `azul push` when no source & destination are given
export type PushMapping = {
	--- File, folder or package to push, relative to the project root
	source: string,
	--- Path to the destination instance, i.e. { "ReplicatedStorage", "Packages" }
	destination: { string },
	--- Wipes the destination's children before pushing
	destructive: boolean?,
	--- Reads `source` as a Rojo project
	rojoMode: boolean?,
	--- Builds the push from this sourcemap (i.e. a pack), including non-script instances
	fromSourcemap: string?,
}

export type PackOnExit = {
	enabled: boolean,
	--- Defaults to "game.sourcemap.json". Can't be the live sourcemap, since live sync overwrites it.
	outputPath: string?,
}

export type Config = {
	pushMappings: { PushMapping }?,
	--- Packs the place when disconnecting from the plugin, or when stopping the Daemon with Ctrl+C while Studio is connected
	packOnExit: PackOnExit?,
	--- Overrides the Daemon's `deleteOrphansOnConnect` for this place
	deleteOrphansOnConnect: boolean?,
	--- Overrides the Daemon's `debugMode` while this place is connected
	debugMode: boolean?,
}

return {}
