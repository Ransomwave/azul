--!strict
--[=[
	Per-place Daemon configuration (ServerStorage.Azul.Config), and the `Types` module the plugin keeps inside it.
]=]
local PlaceConfig = {}

local TYPES_HEADER = "-- Generated by Azul. Changes to this module are overwritten."

PlaceConfig.TYPES_SOURCE = "--!strict\n"
	.. TYPES_HEADER
	.. "\n"
	.. [[

--- Pushed by `azul push` when no source & destination are given
export type PushMapping = {
	--- File, folder or package to push, relative to the project root
	source: string,
	--- Path to the destination instance, i.e. { "ReplicatedStorage", "Packages" }
	destination: { string },
	--- Wipes the destination's children before pushing
	destructive: boolean?,
	--- Reads `source` as a Rojo project
	rojoMode: boolean?,
	--- Builds the push from this sourcemap (i.e. a pack), including non-script instances
	fromSourcemap: string?,
}

export type PackOnExit = {
	enabled: boolean,
	--- Defaults to "game.sourcemap.json". Can't be the live sourcemap, since live sync overwrites it.
	outputPath: string?,
}

export type Config = {
	pushMappings: { PushMapping }?,
	--- Packs the place when disconnecting from the plugin, or when stopping the Daemon with Ctrl+C while Studio is connected
	packOnExit: PackOnExit?,
	--- Overrides the Daemon's `deleteOrphansOnConnect` for this place
	deleteOrphansOnConnect: boolean?,
	--- Overrides the Daemon's `debugMode` while this place is connected
	debugMode: boolean?,
}

return {}
]]

--- Top-level keys of `Config` in `TYPES_SOURCE`
PlaceConfig.KNOWN_KEYS = {
	pushMappings = true,
	packOnExit = true,
	deleteOrphansOnConnect = true,
	debugMode = true,
}

local TEMPLATE_SOURCE = [[
--!strict
-- Per-place Daemon configuration
-- This configuration is sent to the Daemon on sync. It can be used to specify settings for this Place, such as push mappings.

-- More info:
-- https://azul.ransomwave.games/advanced/place-daemon-config/

local Types = require(script.Types)

local config: Types.Config = {}

return config
]]

--[=[
	Creates the `Types` module inside the place config, or updates it if it was generated by an older version.
	A user's own module named `Types` is left alone.
]=]
function PlaceConfig.ensureTypes(configModule: ModuleScript)
	local types = configModule:FindFirstChild("Types")
	if types then
		if not types:IsA("ModuleScript") then return end
		local source = types.Source
		if source == PlaceConfig.TYPES_SOURCE or not string.find(source, TYPES_HEADER, 1, true) then return end
		types.Source = PlaceConfig.TYPES_SOURCE
		return
	end

	local newTypes = Instance.new("ModuleScript")
	newTypes.Name = "Types"
	newTypes.Source = PlaceConfig.TYPES_SOURCE
	newTypes.Parent = configModule
end

--- Finds the place config, creating it from the template if it doesn't exist
function PlaceConfig.getOrCreate(): ModuleScript
	local ServerStorage = game:GetService("ServerStorage")

	local azulFolder = ServerStorage:FindFirstChild("Azul")
	if not azulFolder then
		local newAzulFolder = Instance.new("Folder")
		newAzulFolder.Name = "Azul"
		newAzulFolder.Parent = ServerStorage
		azulFolder = newAzulFolder
	end

	local configModule = (azulFolder :: Instance):FindFirstChild("Config")
	if not configModule or not configModule:IsA("ModuleScript") then
		local newConfigModule = Instance.new("ModuleScript")
		newConfigModule.Name = "Config"
		newConfigModule.Source = TEMPLATE_SOURCE
		newConfigModule.Parent = azulFolder
		configModule = newConfigModule
	end

	PlaceConfig.ensureTypes(configModule :: ModuleScript)
	return configModule :: ModuleScript
end

return PlaceConfig
