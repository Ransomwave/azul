--!strict
--[=[
	Per-place Daemon configuration (ServerStorage.Azul.Config).
	New configs are cloned from the `Config` template below this module, along with its `PlaceConfigTypes` child.
]=]
local PlaceConfig = {}

local TEMPLATE = script.Config
local TYPES = TEMPLATE.PlaceConfigTypes
local TYPES_HEADER = "-- Generated by Azul. Changes to this module are overwritten."

--- Top-level keys of `Config` in `PlaceConfigTypes`
PlaceConfig.KNOWN_KEYS = {
	pushMappings = true,
	packOnExit = true,
	deleteOrphansOnConnect = true,
	debugMode = true,
}

--[=[
	Adds the `PlaceConfigTypes` module to the place config, or updates it if it was generated by an older version.
	A user's own module named `PlaceConfigTypes` is left alone.
]=]
function PlaceConfig.ensureTypes(configModule: ModuleScript)
	local types = configModule:FindFirstChild("PlaceConfigTypes")
	if not types then
		TYPES:Clone().Parent = configModule
		return
	end

	if not types:IsA("ModuleScript") then return end
	if types.Source == TYPES.Source or not string.find(types.Source, TYPES_HEADER, 1, true) then return end
	types.Source = TYPES.Source
end

--- Finds the place config, creating it from the template if it doesn't exist
function PlaceConfig.getOrCreate(): ModuleScript
	local ServerStorage = game:GetService("ServerStorage")

	local azulFolder = ServerStorage:FindFirstChild("Azul")
	if not azulFolder then
		local newAzulFolder = Instance.new("Folder")
		newAzulFolder.Name = "Azul"
		newAzulFolder.Parent = ServerStorage
		azulFolder = newAzulFolder
	end

	local configModule = (azulFolder :: Instance):FindFirstChild("Config")
	if not configModule or not configModule:IsA("ModuleScript") then
		local newConfigModule = TEMPLATE:Clone()
		newConfigModule.Parent = azulFolder
		return newConfigModule
	end

	PlaceConfig.ensureTypes(configModule)
	return configModule
end

return PlaceConfig
